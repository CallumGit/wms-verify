# ============================================================================
# WMS Verify — zmienne środowiskowe (przykład). Skopiuj do .env i uzupełnij.
# ============================================================================

# --- Baza danych (PostgreSQL) ---
DATABASE_URL="postgresql://wms:wms_password@localhost:5432/wms_verify?schema=public"

# --- Redis (kolejki / harmonogram raportów) ---
REDIS_HOST="localhost"
REDIS_PORT="6379"

# --- API ---
API_PORT="3000"
NODE_ENV="development"

# --- Auth (JWT) ---
JWT_SECRET="zmien-to-na-dlugi-losowy-sekret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="zmien-to-na-inny-dlugi-losowy-sekret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Strefa czasowa (harmonogram raportów) ---
TZ="Europe/Warsaw"

# --- Mobile (Expo) — adres API widziany z urządzenia/emulatora ---
# Dla emulatora Androida zwykle: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"
